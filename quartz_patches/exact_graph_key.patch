+std::string Graph::exact_key() const {
+  // A circuit trace is completely determined by the operation sequence on
+  // every physical qubit.  Independent operations may move in a topological
+  // serialization but cannot change any of these per-wire sequences.
+  auto append_u64 = [](std::string &output, uint64_t value) {
+    output.append(reinterpret_cast<const char *>(&value), sizeof(value));
+  };
+  auto append_double = [](std::string &output, double value) {
+    output.append(reinterpret_cast<const char *>(&value), sizeof(value));
+  };
+
+  const int num_qubits = get_num_qubits();
+  std::vector<std::string> wire_traces(num_qubits);
+  std::vector<Op> ops;
+  topology_order_ops(ops);
+  for (const auto &op : ops) {
+    if (!op.ptr->is_quantum_gate()) {
+      continue;
+    }
+    const int gate_qubits = op.ptr->get_num_qubits();
+    const int gate_parameters = op.ptr->get_num_parameters();
+    std::vector<int> qubits(gate_qubits, -1);
+    std::vector<ParamType> parameters(gate_parameters, 0);
+    auto incoming = inEdges.find(op);
+    if (incoming == inEdges.end()) {
+      throw std::runtime_error("quantum operation has no incoming edges");
+    }
+    for (const auto &edge : incoming->second) {
+      if (edge.dstIdx < gate_qubits) {
+        auto logical_qubit = pos_2_logical_qubit.find(Pos(op, edge.dstIdx));
+        if (logical_qubit == pos_2_logical_qubit.end()) {
+          throw std::runtime_error("logical qubit is missing from exact key");
+        }
+        qubits[edge.dstIdx] = logical_qubit->second;
+      } else {
+        const int parameter_index = edge.dstIdx - gate_qubits;
+        auto constant = constant_param_values.find(edge.srcOp);
+        if (parameter_index < 0 || parameter_index >= gate_parameters ||
+            constant == constant_param_values.end()) {
+          throw std::runtime_error(
+              "non-constant gate parameter is unsupported by exact key");
+        }
+        parameters[parameter_index] = constant->second;
+      }
+    }
+
+    std::string token;
+    append_u64(token, static_cast<uint64_t>(op.ptr->tp));
+    append_u64(token, static_cast<uint64_t>(gate_qubits));
+    for (int qubit : qubits) {
+      if (qubit < 0 || qubit >= num_qubits) {
+        throw std::runtime_error("invalid physical qubit in exact key");
+      }
+      append_u64(token, static_cast<uint64_t>(qubit));
+    }
+    append_u64(token, static_cast<uint64_t>(gate_parameters));
+    for (ParamType parameter : parameters) {
+      append_double(token, parameter);
+    }
+    for (int qubit : qubits) {
+      append_u64(wire_traces[qubit], static_cast<uint64_t>(token.size()));
+      wire_traces[qubit].append(token);
+    }
+  }
+
+  std::string result;
+  append_u64(result, static_cast<uint64_t>(num_qubits));
+  for (const auto &wire : wire_traces) {
+    append_u64(result, static_cast<uint64_t>(wire.size()));
+    result.append(wire);
+  }
+  return result;
+}
