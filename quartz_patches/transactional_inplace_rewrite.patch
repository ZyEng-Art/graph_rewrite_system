+GraphMutationTransaction::GraphMutationTransaction(Graph &graph)
+    : graph_(&graph), active_(true) {
+  assert(graph.active_transaction_ == nullptr &&
+         "nested graph mutation transactions are not supported");
+  graph.active_transaction_ = this;
+}
+
+GraphMutationTransaction::~GraphMutationTransaction() { rollback(); }
+
+void GraphMutationTransaction::record_in_edges(const Op &op) {
+  if (original_in_edges_.find(op) != original_in_edges_.end())
+    return;
+  const auto it = graph_->inEdges.find(op);
+  if (it == graph_->inEdges.end())
+    original_in_edges_.emplace(op, std::nullopt);
+  else
+    original_in_edges_.emplace(op, it->second);
+}
+
+void GraphMutationTransaction::record_out_edges(const Op &op) {
+  if (original_out_edges_.find(op) != original_out_edges_.end())
+    return;
+  const auto it = graph_->outEdges.find(op);
+  if (it == graph_->outEdges.end())
+    original_out_edges_.emplace(op, std::nullopt);
+  else
+    original_out_edges_.emplace(op, it->second);
+}
+
+void GraphMutationTransaction::record_constant(const Op &op) {
+  if (original_constants_.find(op) != original_constants_.end())
+    return;
+  const auto it = graph_->constant_param_values.find(op);
+  if (it == graph_->constant_param_values.end())
+    original_constants_.emplace(op, std::nullopt);
+  else
+    original_constants_.emplace(op, it->second);
+}
+
+void GraphMutationTransaction::record_position(const Pos &pos) {
+  if (original_positions_.find(pos) != original_positions_.end())
+    return;
+  const auto it = graph_->pos_2_logical_qubit.find(pos);
+  if (it == graph_->pos_2_logical_qubit.end())
+    original_positions_.emplace(pos, std::nullopt);
+  else
+    original_positions_.emplace(pos, it->second);
+}
+
+void GraphMutationTransaction::note_incremental_position_update() {
+  ++incremental_position_updates_;
+}
+
+void GraphMutationTransaction::export_structural_delta(
+    std::vector<size_t> &removed_node_guids,
+    std::vector<size_t> &added_node_guids,
+    std::vector<int> &added_node_types,
+    std::vector<std::vector<size_t>> &removed_edges,
+    std::vector<std::vector<size_t>> &added_edges) const {
+  removed_node_guids.clear();
+  added_node_guids.clear();
+  added_node_types.clear();
+  removed_edges.clear();
+  added_edges.clear();
+  auto visible_node = [](const Op &op) {
+    return op.ptr->tp != GateType::input_qubit &&
+           op.ptr->tp != GateType::input_param;
+  };
+
+  for (const auto &entry : original_in_edges_) {
+    if (!visible_node(entry.first))
+      continue;
+    const bool existed_before = entry.second.has_value();
+    const bool exists_after =
+        graph_->inEdges.find(entry.first) != graph_->inEdges.end();
+    if (existed_before && !exists_after) {
+      removed_node_guids.emplace_back(entry.first.guid);
+    } else if (!existed_before && exists_after) {
+      added_node_guids.emplace_back(entry.first.guid);
+      added_node_types.emplace_back(static_cast<int>(entry.first.ptr->tp));
+    }
+  }
+
+  auto edge_row = [](const Edge &edge) {
+    return std::vector<size_t>{edge.srcOp.guid, edge.dstOp.guid,
+                               static_cast<size_t>(edge.srcIdx),
+                               static_cast<size_t>(edge.dstIdx)};
+  };
+  for (const auto &entry : original_out_edges_) {
+    if (!visible_node(entry.first))
+      continue;
+    static const std::set<Edge, EdgeCompare> empty_edges;
+    const auto &before =
+        entry.second.has_value() ? *entry.second : empty_edges;
+    const auto current = graph_->outEdges.find(entry.first);
+    const auto &after = current == graph_->outEdges.end()
+                            ? empty_edges
+                            : current->second;
+    for (const auto &edge : before) {
+      if (after.find(edge) == after.end())
+        removed_edges.emplace_back(edge_row(edge));
+    }
+    for (const auto &edge : after) {
+      if (before.find(edge) == before.end())
+        added_edges.emplace_back(edge_row(edge));
+    }
+  }
+}
+
+void GraphMutationTransaction::rollback() {
+  if (!active_)
+    return;
+  // Disable recording first: restoring the snapshots must not extend them.
+  graph_->active_transaction_ = nullptr;
+  for (const auto &entry : original_in_edges_) {
+    if (entry.second.has_value())
+      graph_->inEdges[entry.first] = *entry.second;
+    else
+      graph_->inEdges.erase(entry.first);
+  }
+  for (const auto &entry : original_out_edges_) {
+    if (entry.second.has_value())
+      graph_->outEdges[entry.first] = *entry.second;
+    else
+      graph_->outEdges.erase(entry.first);
+  }
+  for (const auto &entry : original_constants_) {
+    if (entry.second.has_value())
+      graph_->constant_param_values[entry.first] = *entry.second;
+    else
+      graph_->constant_param_values.erase(entry.first);
+  }
+  for (const auto &entry : original_positions_) {
+    if (entry.second.has_value())
+      graph_->pos_2_logical_qubit[entry.first] = *entry.second;
+    else
+      graph_->pos_2_logical_qubit.erase(entry.first);
+  }
+  active_ = false;
+}
+
+size_t GraphMutationTransaction::captured_in_entries() const {
