+std::shared_ptr<Graph> Graph::apply_xfer_with_guid_binding_transactional(
+    GraphXfer *xfer, std::vector<size_t> source_guids,
+    bool eliminate_rotation, ExactKeyRegistry *registry,
+    std::vector<size_t> &dst_guids, std::string &exact_key,
+    std::vector<size_t> &removed_node_guids,
+    std::vector<size_t> &added_node_guids,
+    std::vector<int> &added_node_types,
+    std::vector<std::vector<size_t>> &removed_edges,
+    std::vector<std::vector<size_t>> &added_edges,
+    std::vector<uint64_t> &profile) {
+  using Clock = std::chrono::steady_clock;
+  auto elapsed_ns = [](Clock::time_point started) {
+    return static_cast<uint64_t>(
+        std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now() -
+                                                             started)
+            .count());
+  };
+  // Timings: 0 GUID lookup, 1 source match, 2 input validation,
+  // 3 destination allocation, 4 output validation, 5 in-place rewrite,
+  // 6 loop check, 7 binding export, 8 rotation cleanup, 9 exact key,
+  // 10 registry lookup/insert, 11 novel-child clone, 12 rollback, 13 unmatch,
+  // 14 total. Counters: 15 result, 16..19 captured map entries,
+  // 20 incremental wire-position updates, 21 graph copies, 22 delta-export
+  // time, and 23..26 exported node/edge counts.
+  profile.assign(27, 0);
+  const auto total_started = Clock::now();
+  dst_guids.clear();
+  exact_key.clear();
+  removed_node_guids.clear();
+  added_node_guids.clear();
+  added_node_types.clear();
+  removed_edges.clear();
+  added_edges.clear();
+  std::shared_ptr<Graph> new_graph(nullptr);
+  uint64_t result_code = 0;
+
+  if (registry == nullptr)
+    throw std::invalid_argument("transactional apply requires a key registry");
+
+  std::vector<Op> source_ops;
+  source_ops.reserve(source_guids.size());
+  auto started = Clock::now();
+  for (const size_t guid : source_guids) {
+    bool found = false;
+    for (auto it = inEdges.cbegin(); it != inEdges.cend(); ++it) {
+      if (it->first.guid == guid) {
+        source_ops.emplace_back(it->first);
+        found = true;
+        break;
+      }
+    }
+    if (!found) {
+      result_code = 7;
+      profile[0] += elapsed_ns(started);
+      profile[15] = result_code;
+      profile[14] = elapsed_ns(total_started);
+      return nullptr;
+    }
+  }
+  profile[0] += elapsed_ns(started);
+
+  bool success = source_ops.size() == xfer->srcOps.size();
+  result_code = success ? 0 : 2;
+  std::deque<std::pair<OpX *, Op>> matched_pairs;
+  std::unordered_set<Op, OpHash> seen_ops;
+  auto unmatch_all = [&]() {
+    const auto unmatch_started = Clock::now();
+    while (!matched_pairs.empty()) {
+      const auto pair = matched_pairs.back();
+      matched_pairs.pop_back();
+      xfer->unmatch(pair.first, pair.second, this);
+    }
+    profile[13] += elapsed_ns(unmatch_started);
+  };
+
+  started = Clock::now();
+  if (success) {
+    for (size_t index = 0; index < source_ops.size(); ++index) {
+      OpX *source_opx = xfer->srcOps[index];
+      const Op source_op = source_ops[index];
+      if (seen_ops.find(source_op) != seen_ops.end() ||
+          xfer->mappedOps.find(source_op) != xfer->mappedOps.end() ||
+          !xfer->can_match(source_opx, source_op, this)) {
+        success = false;
+        result_code = 2;
+        break;
+      }
+      xfer->match(source_opx, source_op, this);
+      seen_ops.insert(source_op);
+      matched_pairs.emplace_back(source_opx, source_op);
+    }
+  }
+  profile[1] += elapsed_ns(started);
+
+  started = Clock::now();
+  if (success) {
+    std::set<int> qubits;
+    for (const auto &mapped_input : xfer->mappedInputs) {
+      const Op input_op = mapped_input.second.first;
+      if (input_op.ptr->is_quantum_gate() ||
+          input_op.ptr->tp == GateType::input_qubit) {
+        const auto position =
+            pos_2_logical_qubit.find(Pos(input_op, mapped_input.second.second));
+        if (position == pos_2_logical_qubit.end() ||
+            !qubits.insert(position->second).second) {
+          success = false;
+          result_code = 3;
+          break;
+        }
+      }
+    }
+  }
+  profile[2] += elapsed_ns(started);
+
+  started = Clock::now();
+  if (success) {
+    for (OpX *destination_op : xfer->dstOps) {
+      if (!xfer->create_new_operator(destination_op,
+                                     destination_op->mapOp)) {
+        success = false;
+        result_code = 4;
+        break;
+      }
+    }
+  }
+  profile[3] += elapsed_ns(started);
+
+  started = Clock::now();
+  if (success) {
+    for (const auto &mapped : xfer->mappedOps) {
+      const auto outputs = outEdges.find(mapped.first);
+      if (outputs == outEdges.end())
+        continue;
+      for (const auto &edge : outputs->second) {
+        if (xfer->mappedOps.find(edge.dstOp) == xfer->mappedOps.end()) {
+          const TensorX source_tensor(mapped.second, edge.srcIdx);
+          if (xfer->mappedOutputs.find(source_tensor) ==
+              xfer->mappedOutputs.end()) {
+            success = false;
+            result_code = 5;
+            break;
+          }
+        }
+      }
+      if (!success)
+        break;
+    }
+  }
+  profile[4] += elapsed_ns(started);
+
+  if (!success) {
+    unmatch_all();
+    profile[15] = result_code;
+    profile[14] = elapsed_ns(total_started);
+    return nullptr;
+  }
+
+  try {
+    GraphMutationTransaction transaction(*this);
+    started = Clock::now();
+    xfer->rewrite_graph_in_place(this);
+    profile[5] += elapsed_ns(started);
+
+    started = Clock::now();
+    if (has_loop()) {
+      success = false;
+      result_code = 6;
+    }
+    profile[6] += elapsed_ns(started);
+
+    started = Clock::now();
+    if (success) {
+      dst_guids.reserve(xfer->dstOps.size());
+      for (const OpX *destination_op : xfer->dstOps)
+        dst_guids.emplace_back(destination_op->mapOp.guid);
+    }
+    profile[7] += elapsed_ns(started);
+
+    started = Clock::now();
+    if (success && eliminate_rotation)
+      constant_and_rotation_elimination();
+    profile[8] += elapsed_ns(started);
+
+    started = Clock::now();
+    if (success)
+      exact_key = this->exact_key();
+    profile[9] += elapsed_ns(started);
+
+    bool is_novel = false;
+    started = Clock::now();
+    if (success)
+      is_novel = registry->insert(exact_key);
+    profile[10] += elapsed_ns(started);
+    if (success && !is_novel)
+      result_code = 1;
+
+    started = Clock::now();
+    if (success && is_novel) {
+      new_graph = std::make_shared<Graph>(*this);
+      profile[21] = 1;
+    }
+    profile[11] += elapsed_ns(started);
+
+    profile[16] = transaction.captured_in_entries();
+    profile[17] = transaction.captured_out_entries();
+    profile[18] = transaction.captured_constant_entries();
+    profile[19] = transaction.captured_position_entries();
+    profile[20] = transaction.incremental_position_updates();
+    started = Clock::now();
+    if (success && is_novel) {
+      transaction.export_structural_delta(
+          removed_node_guids, added_node_guids, added_node_types,
+          removed_edges, added_edges);
+    }
+    profile[22] += elapsed_ns(started);
+    profile[23] = removed_node_guids.size();
+    profile[24] = added_node_guids.size();
+    profile[25] = removed_edges.size();
+    profile[26] = added_edges.size();
+    started = Clock::now();
+    transaction.rollback();
+    profile[12] += elapsed_ns(started);
+  } catch (...) {
+    unmatch_all();
+    throw;
+  }
+
+  unmatch_all();
+  if (!success || result_code != 0) {
+    dst_guids.clear();
+    new_graph.reset();
+  }
+  profile[15] = result_code;
+  profile[14] = elapsed_ns(total_started);
+  return new_graph;
+}
