+void Graph::erase_positions_for_op(const Op &op) {
+  if (active_transaction_ == nullptr)
+    return;
+  const int num_qubits = op.ptr->get_num_qubits();
+  for (int index = 0; index < num_qubits; ++index) {
+    const Pos pos(op, index);
+    record_position_before_change(pos);
+    pos_2_logical_qubit.erase(pos);
+  }
+}
+
+void Graph::propagate_position_for_edge(const Op &srcOp, const Op &dstOp,
+                                        int srcIdx, int dstIdx) {
+  if (active_transaction_ == nullptr ||
+      dstIdx >= dstOp.ptr->get_num_qubits())
+    return;
+  const auto source_it = pos_2_logical_qubit.find(Pos(srcOp, srcIdx));
+  if (source_it == pos_2_logical_qubit.end())
+    return;
+
+  const int logical_qubit = source_it->second;
+  std::queue<Pos> pending;
+  std::unordered_set<Pos, PosHash> visited;
+  pending.emplace(dstOp, dstIdx);
+  while (!pending.empty()) {
+    const Pos pos = pending.front();
+    pending.pop();
+    if (!visited.insert(pos).second)
+      continue;
+    const auto current = pos_2_logical_qubit.find(pos);
+    if (current != pos_2_logical_qubit.end() &&
+        current->second == logical_qubit)
+      continue;
+    record_position_before_change(pos);
+    pos_2_logical_qubit[pos] = logical_qubit;
+    active_transaction_->note_incremental_position_update();
+    const auto output_it = outEdges.find(pos.op);
+    if (output_it == outEdges.end())
+      continue;
+    for (const auto &edge : output_it->second) {
+      if (edge.srcIdx == pos.idx &&
+          edge.dstIdx < edge.dstOp.ptr->get_num_qubits())
+        pending.emplace(edge.dstOp, edge.dstIdx);
+    }
+  }
 }
 
