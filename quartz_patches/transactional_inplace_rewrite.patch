+void GraphXfer::rewrite_graph_in_place(Graph *graph) const {
+  // Connect replacement outputs to the untouched part of the parent before
+  // deleting the matched source. The destination operators were allocated by
+  // the caller and are held in OpX::mapOp.
+  for (auto mapped_it = mappedOps.cbegin(); mapped_it != mappedOps.cend();
+       ++mapped_it) {
+    const auto output_it = graph->outEdges.find(mapped_it->first);
+    if (output_it == graph->outEdges.end())
+      continue;
+    const auto output_edges = output_it->second;
+    for (const auto &edge : output_edges) {
+      if (mappedOps.find(edge.dstOp) != mappedOps.end())
+        continue;
+      const TensorX source_tensor(mapped_it->second, edge.srcIdx);
+      const auto mapped_output_it = mappedOutputs.find(source_tensor);
+      assert(mapped_output_it != mappedOutputs.end());
+      const TensorX destination_tensor = mapped_output_it->second;
+      if (destination_tensor.op == nullptr) {
+        const auto input_it = mappedInputs.find(destination_tensor.idx);
+        assert(input_it != mappedInputs.end());
+        graph->add_edge(input_it->second.first, edge.dstOp,
+                        input_it->second.second, edge.dstIdx);
+      } else {
+        graph->add_edge(destination_tensor.op->mapOp, edge.dstOp,
+                        destination_tensor.idx, edge.dstIdx);
+      }
+    }
+  }
+
+  for (const auto &mapped : mappedOps)
+    graph->remove_node_wo_input_output_connect(mapped.first);
+
+  // Materialize replacement inputs and internal edges. add_edge performs the
+  // incremental logical-wire propagation while the transaction is active.
+  for (OpX *destination_opx : dstOps) {
+    for (size_t input_index = 0; input_index < destination_opx->inputs.size();
+         ++input_index) {
+      if (destination_opx->inputs[input_index].op == nullptr) {
+        const int tensor_index = destination_opx->inputs[input_index].idx;
+        const auto parameter_it = paramValues.find(tensor_index);
+        if (parameter_it != paramValues.end()) {
+          const Op constant_op(context->next_global_unique_id(),
+                               context->get_gate(GateType::input_param));
+          graph->set_constant_param_value(constant_op, parameter_it->second);
+          graph->add_edge(constant_op, destination_opx->mapOp, 0,
+                          input_index);
+          continue;
+        }
+        const auto input_it = mappedInputs.find(tensor_index);
+        assert(input_it != mappedInputs.end());
+        graph->add_edge(input_it->second.first, destination_opx->mapOp,
+                        input_it->second.second, input_index);
+      } else {
+        OpX *source_opx = destination_opx->inputs[input_index].op;
+        graph->add_edge(source_opx->mapOp, destination_opx->mapOp,
+                        destination_opx->inputs[input_index].idx,
+                        input_index);
+      }
+    }
+  }
+}
