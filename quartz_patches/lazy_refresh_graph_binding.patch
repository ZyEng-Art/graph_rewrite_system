   return new_graph;
 }
 
+std::shared_ptr<Graph>
+Graph::apply_xfer_with_guid_binding_and_bindings(
+    GraphXfer *xfer, std::vector<size_t> source_guids,
+    bool eliminate_rotation, std::vector<size_t> &dst_guids) const {
+  std::vector<Op> source_ops;
+  source_ops.reserve(source_guids.size());
+  for (const auto guid : source_guids) {
+    bool found = false;
+    for (auto it = inEdges.cbegin(); it != inEdges.cend(); ++it) {
+      if (it->first.guid == guid) {
+        source_ops.emplace_back(it->first);
+        found = true;
+        break;
+      }
+    }
+    if (!found) {
+      dst_guids.clear();
+      return std::shared_ptr<Graph>(nullptr);
+    }
+  }
+  std::vector<size_t> matched_src_guids;
+  return apply_xfer_with_op_binding_and_bindings(
+      xfer, std::move(source_ops), eliminate_rotation, matched_src_guids,
+      dst_guids);
+}
