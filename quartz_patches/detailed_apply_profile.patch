+std::shared_ptr<Graph>
+Graph::apply_xfer_with_op_binding_and_bindings_profiled(
+    GraphXfer *xfer, std::vector<Op> source_ops, bool eliminate_rotation,
+    std::vector<size_t> &src_guids, std::vector<size_t> &dst_guids,
+    std::vector<uint64_t> &profile) const {
+  using Clock = std::chrono::steady_clock;
+  auto elapsed_ns = [](Clock::time_point started) {
+    return static_cast<uint64_t>(
+        std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now() -
+                                                             started)
+            .count());
+  };
+  // 0 is populated by the GUID wrapper. 1..9 are the native apply phases,
+  // 10 is a result code, and 11 is total time in the profiled C++ API.
+  if (profile.size() < 12)
+    profile.resize(12, 0);
+  src_guids.clear();
+  dst_guids.clear();
+  std::shared_ptr<Graph> new_graph(nullptr);
+  bool success = source_ops.size() == xfer->srcOps.size();
+  uint64_t result_code = success ? 0 : 1;
+  std::deque<std::pair<OpX *, Op>> matched_opx_op_pairs_dq;
+  std::unordered_set<Op, OpHash> seen_ops;
+
+  auto started = Clock::now();
+  if (success) {
+    for (size_t i = 0; i < source_ops.size(); ++i) {
+      OpX *src_opx = xfer->srcOps[i];
+      Op op = source_ops[i];
+      if (seen_ops.find(op) != seen_ops.end() ||
+          xfer->mappedOps.find(op) != xfer->mappedOps.end() ||
+          !xfer->can_match(src_opx, op, this)) {
+        success = false;
+        result_code = 1;
+        break;
+      }
+      xfer->match(src_opx, op, this);
+      seen_ops.insert(op);
+      matched_opx_op_pairs_dq.push_back(std::make_pair(src_opx, op));
+    }
+  }
+  profile[1] += elapsed_ns(started);
+
+  started = Clock::now();
+  if (success) {
+    std::set<int> qubits;
+    for (auto it = xfer->mappedInputs.cbegin();
+         it != xfer->mappedInputs.cend(); ++it) {
+      if (it->second.first.ptr->is_quantum_gate() ||
+          it->second.first.ptr->tp == GateType::input_qubit) {
+        Pos p = Pos(it->second.first, it->second.second);
+        auto q = pos_2_logical_qubit.find(p)->second;
+        if (qubits.find(q) != qubits.end()) {
+          success = false;
+          result_code = 2;
+          break;
+        }
+        qubits.insert(q);
+      }
+    }
+  }
+  profile[2] += elapsed_ns(started);
+
+  started = Clock::now();
+  if (success) {
+    for (auto dst_it = xfer->dstOps.cbegin();
+         dst_it != xfer->dstOps.cend(); ++dst_it) {
+      OpX *dst_op = *dst_it;
+      if (!xfer->create_new_operator(dst_op, dst_op->mapOp)) {
+        success = false;
+        result_code = 3;
+        break;
+      }
+    }
+  }
+  profile[3] += elapsed_ns(started);
+
+  started = Clock::now();
+  if (success) {
+    for (auto mapped_ops_it = xfer->mappedOps.cbegin();
+         mapped_ops_it != xfer->mappedOps.cend() && success;
+         ++mapped_ops_it) {
+      if (outEdges.find(mapped_ops_it->first) == outEdges.end())
+        continue;
+      const std::set<Edge, EdgeCompare> &list =
+          outEdges.find(mapped_ops_it->first)->second;
+      for (auto edge_it = list.cbegin(); edge_it != list.cend() && success;
+           ++edge_it) {
+        if (xfer->mappedOps.find(edge_it->dstOp) == xfer->mappedOps.end()) {
+          TensorX src_ten;
+          src_ten.op = mapped_ops_it->second;
+          src_ten.idx = edge_it->srcIdx;
+          if (xfer->mappedOutputs.find(src_ten) == xfer->mappedOutputs.end()) {
+            success = false;
+            result_code = 4;
+          }
+        }
+      }
+    }
+  }
+  profile[4] += elapsed_ns(started);
+
+  if (success) {
+    assert(seen_ops.size() == xfer->srcOps.size());
+    started = Clock::now();
+    new_graph = xfer->create_new_graph(this);
+    profile[5] += elapsed_ns(started);
+    started = Clock::now();
+    if (new_graph->has_loop()) {
+      new_graph.reset();
+      success = false;
+      result_code = 5;
+    }
+    profile[6] += elapsed_ns(started);
+  }
+
+  started = Clock::now();
+  if (success) {
+    src_guids.reserve(xfer->srcOps.size());
+    for (const auto *opx : xfer->srcOps)
+      src_guids.emplace_back(opx->mapOp.guid);
+    dst_guids.reserve(xfer->dstOps.size());
+    for (const auto *opx : xfer->dstOps)
+      dst_guids.emplace_back(opx->mapOp.guid);
+  }
+  profile[7] += elapsed_ns(started);
+
+  started = Clock::now();
+  if (success && eliminate_rotation)
+    new_graph->constant_and_rotation_elimination();
+  profile[8] += elapsed_ns(started);
+
+  started = Clock::now();
+  while (!matched_opx_op_pairs_dq.empty()) {
+    auto opx_op_pair = matched_opx_op_pairs_dq.back();
+    matched_opx_op_pairs_dq.pop_back();
+    xfer->unmatch(opx_op_pair.first, opx_op_pair.second, this);
+  }
+  profile[9] += elapsed_ns(started);
+  if (!success) {
+    src_guids.clear();
+    dst_guids.clear();
+  }
+  profile[10] = result_code;
+  return new_graph;
+}
+
+std::shared_ptr<Graph>
+Graph::apply_xfer_with_guid_binding_and_bindings_profiled(
+    GraphXfer *xfer, std::vector<size_t> source_guids,
+    bool eliminate_rotation, std::vector<size_t> &dst_guids,
+    std::vector<uint64_t> &profile) const {
+  using Clock = std::chrono::steady_clock;
+  const auto total_started = Clock::now();
+  profile.assign(12, 0);
+  std::vector<Op> source_ops;
+  source_ops.reserve(source_guids.size());
+  const auto guid_started = Clock::now();
+  for (const auto guid : source_guids) {
+    bool found = false;
+    for (auto it = inEdges.cbegin(); it != inEdges.cend(); ++it) {
+      if (it->first.guid == guid) {
+        source_ops.emplace_back(it->first);
+        found = true;
+        break;
+      }
+    }
+    if (!found) {
+      dst_guids.clear();
+      profile[0] = static_cast<uint64_t>(
+          std::chrono::duration_cast<std::chrono::nanoseconds>(
+              Clock::now() - guid_started)
+              .count());
+      profile[10] = 6;
+      profile[11] = static_cast<uint64_t>(
+          std::chrono::duration_cast<std::chrono::nanoseconds>(
+              Clock::now() - total_started)
+              .count());
+      return std::shared_ptr<Graph>(nullptr);
+    }
+  }
+  profile[0] = static_cast<uint64_t>(
+      std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now() -
+                                                           guid_started)
+          .count());
+  std::vector<size_t> matched_src_guids;
+  auto result = apply_xfer_with_op_binding_and_bindings_profiled(
+      xfer, std::move(source_ops), eliminate_rotation, matched_src_guids,
+      dst_guids, profile);
+  profile[11] = static_cast<uint64_t>(
+      std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now() -
+                                                           total_started)
+          .count());
+  return result;
+}
