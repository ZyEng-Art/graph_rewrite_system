+    def apply_xfer_with_guid_binding_profiled(self, *, PyXfer xfer, source_node_guids, eliminate_rotation:bool = False):
+        """Apply a known binding and return native nanosecond stage timings."""
+        cdef vector[size_t] source_guids
+        cdef vector[size_t] dst_guids
+        cdef vector[uint64_t] profile
+        if xfer.is_nop:
+            return self, [], [0] * 12
+        source_guids.reserve(len(source_node_guids))
+        for value in source_node_guids:
+            source_guids.push_back(value)
+        ret = deref(self.graph).apply_xfer_with_guid_binding_and_bindings_profiled(
+            xfer.graphXfer,
+            source_guids,
+            eliminate_rotation,
+            dst_guids,
+            profile,
+        )
+        profile_values = [profile[i] for i in range(profile.size())]
+        if ret.get() == NULL:
+            return None, [], profile_values
+        return (
+            PyGraph().set_this_deferred(ret),
+            [dst_guids[i] for i in range(dst_guids.size())],
+            profile_values,
+        )
